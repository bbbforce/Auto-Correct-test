# ── 全局默认配置 ──────────────────────────────────────────────────────────────
# API Key（全局共用，或被各 Agent 的专属 API_KEY 覆盖）
OPENAI_API_KEY=sk-your-api-key-here

# 全局默认模型
LLM_MODEL=gpt-4o

# 全局默认服务商接口（OpenAI 官方可留空）
LLM_BASE_URL=

# ── 各 Agent 专属配置（优先级高于全局，留空/删除则使用全局默认）────────────────
# 格式：<AGENT>_MODEL / <AGENT>_BASE_URL / <AGENT>_API_KEY
#
# 示例：让 CodeBuilderAgent 使用 DeepSeek，其余仍用全局 Qwen
# CODE_BUILDER_MODEL=deepseek-chat
# CODE_BUILDER_BASE_URL=https://api.deepseek.com
# CODE_BUILDER_API_KEY=sk-xxxxxxxxxxxxxxxx

# InputClarifierAgent
# INPUT_CLARIFIER_MODEL=
# INPUT_CLARIFIER_BASE_URL=
# INPUT_CLARIFIER_API_KEY=

# ParsingAgent
# PARSING_MODEL=
# PARSING_BASE_URL=
# PARSING_API_KEY=

# CodeBuilderAgent
# CODE_BUILDER_MODEL=
# CODE_BUILDER_BASE_URL=
# CODE_BUILDER_API_KEY=

# ErrorDiagnosisAgent
# ERROR_DIAGNOSIS_MODEL=
# ERROR_DIAGNOSIS_BASE_URL=
# ERROR_DIAGNOSIS_API_KEY=

# MechanicalInsightAgent
# MECHANICAL_INSIGHT_MODEL=
# MECHANICAL_INSIGHT_BASE_URL=
# MECHANICAL_INSIGHT_API_KEY=

# ResultEvaluationAgent
# RESULT_EVALUATION_MODEL=
# RESULT_EVALUATION_BASE_URL=
# RESULT_EVALUATION_API_KEY=

# ── ParaView 配置（可选）─────────────────────────────────────────────────────
# PVPYTHON_PATH=/opt/paraview-osmesa/bin/pvpython
